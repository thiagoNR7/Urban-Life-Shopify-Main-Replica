{{ 'ul-tokens.css' | asset_url | stylesheet_tag }}
{{ 'ul-base.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ul_logo_height = section.settings.logo_height | default: 42
  assign ul_fallback_logo_width = ul_logo_height | times: 1914 | divided_by: 2406.0 | round

  if section.settings.logo != blank
    assign ul_logo_width = ul_logo_height | times: section.settings.logo.aspect_ratio | round
  else
    assign ul_logo_width = ul_fallback_logo_width
  endif

  assign ul_logo_style = '--ul-logo-height: ' | append: ul_logo_height | append: 'px; --ul-logo-width: ' | append: ul_logo_width | append: 'px;'

  assign ul_wa_number = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign ul_wa_message = section.settings.whatsapp_message | url_encode
  assign ul_wa_href = 'https://wa.me/' | append: ul_wa_number | append: '?text=' | append: ul_wa_message

  # Link 3 do menu ("Produtores"): usa a URL configurada no editor do tema
  # quando preenchida; caso contrario, monta o destino temporario da pagina
  # de produtores (?view=produtores ainda e necessario porque o template
  # personalizado nao foi atribuido definitivamente a pagina no Admin).
  assign ul_menu_link_3_href = section.settings.menu_link_3_url
  if ul_menu_link_3_href == blank
    assign ul_producers_page_url = pages.produtores.url | default: '/pages/produtores'
    assign ul_menu_link_3_href = ul_producers_page_url | append: '?view=produtores'
  endif
-%}

<ul-header-component class="ul-header" id="UlHeader-{{ section.id }}">
  <nav
    class="ul-header__navbar"
    aria-label="Menu principal"
  >
    <div class="ul-header__brand">
      <a
        href="{{ routes.root_url }}"
        class="ul-header__logo-link"
      >
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 400
            | image_tag:
              alt: shop.name,
              class: 'ul-header__logo',
              height: ul_logo_height,
              width: ul_logo_width,
              widths: '200, 300, 400',
              loading: 'eager',
              style: ul_logo_style
          }}
        {%- else -%}
          <img
            src="{{ 'ul-logo.png' | asset_url }}"
            alt="{{ shop.name }}"
            class="ul-header__logo"
            height="{{ ul_logo_height }}"
            width="{{ ul_fallback_logo_width }}"
            style="{{ ul_logo_style }}"
            loading="eager"
          >
        {%- endif -%}
      </a>
    </div>

    <ul
      class="ul-header__menu ul-header__menu--desktop"
      role="list"
    >
      <li class="ul-header__menu-item">
        <a href="{{ section.settings.menu_link_1_url | default: routes.root_url }}" class="ul-header__menu-link">{{ section.settings.menu_link_1_label }}</a>
      </li>
      <li class="ul-header__menu-item">
        <a href="{{ section.settings.menu_link_2_url | default: routes.all_products_collection_url }}" class="ul-header__menu-link">{{ section.settings.menu_link_2_label }}</a>
      </li>
      <li class="ul-header__menu-item">
        <a href="{{ ul_menu_link_3_href }}" class="ul-header__menu-link">{{ section.settings.menu_link_3_label }}</a>
      </li>
      <li class="ul-header__menu-item">
        <a href="{{ section.settings.menu_link_4_url | default: '#como-funciona' }}" class="ul-header__menu-link">{{ section.settings.menu_link_4_label }}</a>
      </li>
    </ul>

    <div class="ul-header__actions">
      {%- if shop.customer_accounts_enabled -%}
        <div class="ul-header__account">
          <shopify-account menu="customer-account-main-menu">
            {%- unless customer -%}
              <span slot="signed-out-avatar" class="ul-header__account-icon" aria-hidden="true">
                {% render 'ul-icon', name: 'user', size: 20 %}
              </span>
            {%- endunless -%}
          </shopify-account>
        </div>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="ul-header__cart-link"
        aria-label="Carrinho{% if cart.item_count > 0 %}, {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}itens{% endif %}{% endif %}"
      >
        <svg
          class="ul-header__cart-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="8" cy="21" r="1"></circle>
          <circle cx="19" cy="21" r="1"></circle>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="ul-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>

      <a
        href="{{ ul_wa_href }}"
        class="ul-btn ul-btn--solid ul-btn--sm ul-header__producer-cta"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Sou Produtor: falar no WhatsApp (abre em nova aba)"
      >
        {% render 'ul-icon', name: 'sprout', size: 16 %}
        Sou Produtor
      </a>

      <button
        ref="hamburger"
        type="button"
        class="ul-header__hamburger"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="UlHeaderMobileMenu-{{ section.id }}"
        on:click="/toggleMenu"
      >
        <span class="ul-header__hamburger-bar"></span>
        <span class="ul-header__hamburger-bar"></span>
        <span class="ul-header__hamburger-bar"></span>
      </button>
    </div>
  </nav>

  <div
    ref="mobileMenu"
    id="UlHeaderMobileMenu-{{ section.id }}"
    class="ul-header__mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    aria-hidden="true"
    inert
  >
    <a href="{{ section.settings.menu_link_1_url | default: routes.root_url }}" class="ul-header__mobile-menu-link">{{ section.settings.menu_link_1_label }}</a>
    <a href="{{ section.settings.menu_link_2_url | default: routes.all_products_collection_url }}" class="ul-header__mobile-menu-link">{{ section.settings.menu_link_2_label }}</a>
    <a href="{{ ul_menu_link_3_href }}" class="ul-header__mobile-menu-link">{{ section.settings.menu_link_3_label }}</a>
    <a href="{{ section.settings.menu_link_4_url | default: '#como-funciona' }}" class="ul-header__mobile-menu-link">{{ section.settings.menu_link_4_label }}</a>
    <a
      href="{{ ul_wa_href }}"
      class="ul-header__mobile-menu-link ul-header__mobile-menu-link--cta"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Sou Produtor: falar no WhatsApp (abre em nova aba)"
    >
      {% render 'ul-icon', name: 'sprout', size: 16 %}
      Sou Produtor
    </a>
  </div>
</ul-header-component>

<script
  src="{{ 'ul-header.js' | asset_url }}"
  type="module"
></script>

{% stylesheet %}
  .ul-header {
    position: sticky;
    top: 0;
    z-index: var(--ul-z-navbar);
  }

  .ul-header__navbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--ul-space-menu-gap);
    padding: var(--ul-space-navbar-block) var(--ul-space-navbar-inline);
    background: var(--ul-gradient-navbar);
    box-shadow: var(--ul-shadow-navbar);
  }

  .ul-header__brand {
    display: flex;
    align-items: center;
    justify-self: start;
    flex-shrink: 0;
  }

  .ul-header__logo-link {
    display: inline-flex;
  }

  .ul-header__logo {
    display: block;
    width: var(--ul-logo-width);
    height: var(--ul-logo-height);
    object-fit: contain;
  }

  .ul-header__menu {
    list-style: none;
    display: flex;
    justify-self: center;
    gap: var(--ul-space-menu-gap);
    margin: 0;
    padding: 0;
  }

  .ul-header__menu-item {
    position: relative;
  }

  .ul-header__menu-link {
    display: inline-block;
    position: relative;
    padding-bottom: 4px;
    color: var(--ul-color-white);
    font-family: var(--ul-font-family);
    font-weight: var(--ul-font-weight-medium);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--ul-transition-fast);
    white-space: nowrap;
  }

  .ul-header__menu-link:hover,
  .ul-header__menu-link:focus-visible {
    color: rgba(255, 255, 255, 0.9);
  }

  .ul-header__menu-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0%;
    height: 2px;
    background: var(--ul-color-underline);
    transition: width var(--ul-transition-fast), left var(--ul-transition-fast);
  }

  .ul-header__menu-link:hover::after,
  .ul-header__menu-link:focus-visible::after {
    left: 0;
    width: 100%;
  }

  .ul-header__actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: var(--ul-space-menu-gap);
    flex-shrink: 0;
  }

  .ul-header__hamburger {
    display: none;
    width: 32px;
    height: 26px;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    padding: 0;
  }

  .ul-header__hamburger-bar {
    width: 100%;
    height: 3px;
    background-color: var(--ul-color-white);
    border-radius: 3px;
  }

  .ul-header__mobile-menu {
    position: fixed;
    inset: 0;
    background: var(--ul-color-menu-mobile-overlay);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--ul-space-menu-mobile-gap);
    transform: translateY(-100%);
    transition: transform var(--ul-transition-menu-mobile);
    z-index: var(--ul-z-menu-mobile);
    pointer-events: none;
  }

  .ul-header__mobile-menu--open {
    transform: translateY(0);
    pointer-events: auto;
  }

  .ul-header__mobile-menu-link {
    color: var(--ul-color-white);
    font-family: var(--ul-font-family);
    font-size: var(--ul-font-size-menu-mobile);
    text-decoration: none;
  }

  .ul-header__mobile-menu-link--cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ul-header__producer-cta {
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .ul-header__producer-cta {
      display: none;
    }
  }

  .ul-header__account {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  shopify-account {
    --shopify-account-font-heading: var(--ul-font-family);
    --shopify-account-font-heading-weight: var(--ul-font-weight-bold);
    --shopify-account-font-body: var(--ul-font-family);
    --shopify-account-font-body-weight: var(--ul-font-weight-regular);
    --shopify-account-radius-base: var(--ul-radius-lg);
    --shopify-account-radius-button: var(--ul-radius-pill);
    --shopify-account-radius-button-small: var(--ul-radius-pill);
    --shopify-account-radius-input: var(--ul-radius-base);
    --shopify-account-color-background: var(--ul-color-white);
    --shopify-account-color-text: var(--ul-color-foreground);
    --shopify-account-color-accent: var(--ul-color-primary);
    --shopify-account-color-accent-text: var(--ul-color-primary-foreground);
    color: var(--ul-color-white);
  }

  shopify-account:not(:defined) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .ul-header__account-icon {
    display: inline-flex;
  }

  .ul-header__cart-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: var(--ul-color-white);
    flex-shrink: 0;
  }

  .ul-header__cart-icon {
    width: 20px;
    height: 20px;
  }

  .ul-header__cart-count {
    position: absolute;
    top: -8px;
    right: -8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: var(--ul-radius-pill);
    background: var(--ul-color-orange);
    color: var(--ul-color-white);
    font-family: var(--ul-font-family);
    font-size: 11px;
    font-weight: var(--ul-font-weight-semibold);
  }

  @media (max-width: 900px) {
    .ul-header__menu--desktop {
      display: none;
    }

    .ul-header__hamburger {
      display: flex;
    }
  }

  @media (max-width: 600px) {
    .ul-header__navbar {
      padding: var(--ul-space-navbar-block-mobile) var(--ul-space-navbar-inline-mobile);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header Urban Life",
  "tag": "header",
  "class": "ul-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Se nenhum logo for selecionado, o logo original da Urban Life (assets/ul-logo.png) e usado como fallback."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Altura do logo",
      "min": 24,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "text",
      "id": "menu_link_1_label",
      "label": "Link 1 - Texto",
      "default": "Início"
    },
    {
      "type": "url",
      "id": "menu_link_1_url",
      "label": "Link 1 - URL"
    },
    {
      "type": "text",
      "id": "menu_link_2_label",
      "label": "Link 2 - Texto",
      "default": "Produtos em destaque"
    },
    {
      "type": "url",
      "id": "menu_link_2_url",
      "label": "Link 2 - URL"
    },
    {
      "type": "text",
      "id": "menu_link_3_label",
      "label": "Link 3 - Texto",
      "default": "Produtores"
    },
    {
      "type": "url",
      "id": "menu_link_3_url",
      "label": "Link 3 - URL",
      "info": "Fallback temporario: aponta para /pages/produtores?view=produtores enquanto a pagina padrao nao renderiza o template correto. Atualize aqui quando a pagina for corrigida."
    },
    {
      "type": "text",
      "id": "menu_link_4_label",
      "label": "Link 4 - Texto",
      "default": "Como funciona"
    },
    {
      "type": "url",
      "id": "menu_link_4_url",
      "label": "Link 4 - URL"
    },
    {
      "type": "header",
      "content": "Sou Produtor (WhatsApp)"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Numero de WhatsApp",
      "info": "Formato internacional, com ou sem simbolos (ex: +55 11 95235-3041). Simbolos +, espacos, - e parenteses sao removidos automaticamente ao montar o link.",
      "default": "+55 11 95235-3041"
    },
    {
      "type": "textarea",
      "id": "whatsapp_message",
      "label": "Mensagem pre-preenchida",
      "default": "Olá! Sou produtor e gostaria de saber como vender meus produtos pela Urban Life."
    }
  ],
  "presets": [
    {
      "name": "Header Urban Life",
      "settings": {
        "logo_height": 42
      }
    }
  ]
}
{% endschema %}
