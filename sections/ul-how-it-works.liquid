{{ 'ul-tokens.css' | asset_url | stylesheet_tag }}
{{ 'ul-base.css' | asset_url | stylesheet_tag }}
{{ 'ul-animations.css' | asset_url | stylesheet_tag }}

<section id="como-funciona" class="ul-how">
  <div class="ul-container">
    <h2 class="ul-how__heading ul-reveal">{{ section.settings.heading }}</h2>
    <p class="ul-how__subheading ul-reveal ul-reveal-delay-1">{{ section.settings.subheading }}</p>

    <div class="ul-how__icons">
      {%- for block in section.blocks -%}
        <span class="ul-how__icon ul-reveal ul-reveal-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% render 'ul-icon', name: block.settings.icon, size: 40 %}
        </span>
      {%- endfor -%}
    </div>

    <div class="ul-how__grid">
      {%- for block in section.blocks -%}
        <div class="ul-how__card ul-reveal ul-reveal-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="ul-how__step">{{ forloop.index }}</span>
          <h3 class="ul-how__card-title">{{ block.settings.title }}</h3>
          <p class="ul-how__card-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'ul-reveal.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .ul-how {
    background: var(--ul-color-card);
    border-block: 1px solid var(--ul-color-border);
    padding-block: 5rem;
  }

  .ul-how__heading {
    margin: 0 0 1rem;
    font-family: var(--ul-font-family);
    font-size: 1.875rem;
    font-weight: var(--ul-font-weight-bold);
    color: var(--ul-color-foreground);
    text-align: center;
  }

  .ul-how__subheading {
    margin: 0 auto 3.5rem;
    max-width: 36rem;
    color: var(--ul-color-muted-foreground);
    text-align: center;
  }

  .ul-how__icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    max-width: 28rem;
    margin: 0 auto 2rem;
  }

  .ul-how__icon {
    display: flex;
    justify-content: center;
    color: var(--ul-color-primary);
  }

  .ul-how__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .ul-how__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ul-how__card {
    background: var(--ul-color-background);
    border: 1px solid rgb(var(--ul-color-border-rgb) / 0.5);
    border-radius: var(--ul-radius-card);
    padding: 2rem;
    text-align: center;
  }

  .ul-how__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: 1.25rem;
    border-radius: var(--ul-radius-pill);
    background: var(--ul-color-accent);
    color: var(--ul-color-white);
    font-family: var(--ul-font-family);
    font-weight: var(--ul-font-weight-bold);
    font-size: 1.125rem;
  }

  .ul-how__card-title {
    margin: 0 0 0.75rem;
    font-family: var(--ul-font-family);
    font-size: 1.125rem;
    font-weight: var(--ul-font-weight-bold);
    color: var(--ul-color-foreground);
  }

  .ul-how__card-desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--ul-color-muted-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Como Funciona",
  "tag": "section",
  "class": "ul-how-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Como funciona"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Do campo urbano à sua mesa — experiência premium de conveniência e alimentos frescos."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Passo",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "sprout", "label": "Broto" },
            { "value": "truck", "label": "Caminhão" },
            { "value": "home", "label": "Casa" }
          ],
          "default": "sprout"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descrição"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Como Funciona",
      "blocks": [
        { "type": "step", "settings": { "icon": "sprout", "title": "Escolha sua cesta", "description": "Selecione o tamanho ideal para o seu consumo semanal. Seleção curada de alimentos frescos de hortas urbanas." } },
        { "type": "step", "settings": { "icon": "truck", "title": "Agendamos sua entrega", "description": "Entrega programada por região. Sem surpresas — você sabe exatamente quando vai chegar." } },
        { "type": "step", "settings": { "icon": "home", "title": "Receba em casa", "description": "Embalagem kraft premium, organizada e minimalista. Fresco, rastreável e pronto para a semana." } }
      ]
    }
  ]
}
{% endschema %}
