        { "type": "cluster", "settings": { "zone": "Zona Sul", "horta": "Horta Zona Sul", "day": "Sexta-feira", "radius": "12 km", "neighborhoods": "Vila Mariana, Saúde, Moema, Ibirapuera, Jabaquara, Santo André" } }
      ]
    }
  ]
}
{% endschema %}
