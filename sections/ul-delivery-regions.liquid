{{ 'ul-tokens.css' | asset_url | stylesheet_tag }}
{{ 'ul-base.css' | asset_url | stylesheet_tag }}
{{ 'ul-animations.css' | asset_url | stylesheet_tag }}

<section class="ul-regions">
  <div class="ul-container">
    <div class="ul-regions__intro ul-reveal">
      <span class="ul-eyebrow ul-regions__eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="ul-regions__heading">{{ section.settings.heading }}</h2>
      <p class="ul-regions__subheading">{{ section.settings.subheading }}</p>
    </div>

    <div class="ul-regions__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign ul_neighborhoods = block.settings.neighborhoods | split: ','
          assign ul_delay = forloop.index | modulo: 4 | plus: 1
        -%}
        <div class="ul-regions__card ul-reveal ul-reveal-delay-{{ ul_delay }}" {{ block.shopify_attributes }}>
          <div class="ul-regions__card-head">
            <div>
              <p class="ul-regions__card-eyebrow">Cluster regional</p>
              <h3 class="ul-regions__zone">{{ block.settings.zone }}</h3>
              <p class="ul-regions__horta">{{ block.settings.horta }}</p>
            </div>
            <div class="ul-regions__day">
              {% render 'ul-icon', name: 'clock', size: 12 %}
              <span>{{ block.settings.day }}</span>
            </div>
          </div>

          <div class="ul-regions__neighborhoods">
            {%- for neighborhood in ul_neighborhoods -%}
              <span class="ul-regions__pill">{{ neighborhood | strip }}</span>
            {%- endfor -%}
          </div>

          <div class="ul-regions__radius">
            {% render 'ul-icon', name: 'map-pin', size: 12 %}
            <span>Raio de entrega: <strong>{{ block.settings.radius }}</strong></span>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <p class="ul-regions__footer-note">
      Sua região não está listada?
      <a href="{{ section.settings.contact_link | default: '#' }}" class="ul-regions__contact-link">Entre em contato</a>
      — estamos expandindo nossa operação em São Paulo.
    </p>
  </div>
</section>

<script src="{{ 'ul-reveal.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .ul-regions {
    background: rgb(var(--ul-color-secondary-rgb) / 0.3);
    border-block: 1px solid var(--ul-color-border);
    padding-block: 5rem;
  }

  .ul-regions__intro {
    max-width: 42rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .ul-regions__eyebrow {
    margin-bottom: 0.75rem;
  }

  .ul-regions__heading {
    margin: 0 0 1rem;
    font-family: var(--ul-font-family);
    font-size: 1.875rem;
    font-weight: var(--ul-font-weight-bold);
    color: var(--ul-color-foreground);
  }

  .ul-regions__subheading {
    margin: 0;
    color: var(--ul-color-muted-foreground);
    line-height: 1.625;
  }

  .ul-regions__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .ul-regions__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ul-regions__card {
    background: #f9fafb;
    border: 1px solid rgb(var(--ul-color-border-rgb) / 0.7);
    border-radius: var(--ul-radius-card);
    padding: 1.75rem;
    transition: border-color var(--ul-transition-fast), box-shadow var(--ul-transition-fast);
  }

  .ul-regions__card:hover {
    border-color: rgb(var(--ul-color-primary-rgb) / 0.3);
    box-shadow: var(--ul-shadow-card-md);
  }

  .ul-regions__card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .ul-regions__card-eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.625rem;
    font-weight: var(--ul-font-weight-semibold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(var(--ul-color-primary-rgb) / 0.6);
  }

  .ul-regions__zone {
    margin: 0;
    font-family: var(--ul-font-family);
    font-size: 1.125rem;
    font-weight: var(--ul-font-weight-bold);
    color: var(--ul-color-foreground);
  }

  .ul-regions__horta {
    margin: 0.125rem 0 0;
    font-size: 0.875rem;
    color: var(--ul-color-muted-foreground);
  }

  .ul-regions__day {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    padding: 0.375rem 0.75rem;
    border-radius: var(--ul-radius-pill);
    background: rgb(var(--ul-color-primary-rgb) / 0.1);
    color: var(--ul-color-primary);
    font-size: 0.75rem;
    font-weight: var(--ul-font-weight-medium);
  }

  .ul-regions__neighborhoods {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }

  .ul-regions__pill {
    padding: 0.25rem 0.625rem;
    border-radius: var(--ul-radius-pill);
    border: 1px solid rgb(var(--ul-color-border-rgb) / 0.5);
    background: var(--ul-color-secondary);
    color: rgb(var(--ul-color-foreground-rgb) / 0.7);
    font-size: 0.75rem;
  }

  .ul-regions__radius {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--ul-color-border-rgb) / 0.5);
    color: var(--ul-color-muted-foreground);
    font-size: 0.75rem;
  }

  .ul-regions__radius svg {
    color: rgb(var(--ul-color-primary-rgb) / 0.5);
    flex-shrink: 0;
  }

  .ul-regions__radius strong {
    color: rgb(var(--ul-color-foreground-rgb) / 0.7);
  }

  .ul-regions__footer-note {
    margin: 2.5rem 0 0;
    text-align: center;
    font-size: 0.75rem;
    color: var(--ul-color-muted-foreground);
  }

  .ul-regions__contact-link {
    color: var(--ul-color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Entrega por Região",
  "tag": "section",
  "class": "ul-regions-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Logística Inteligente"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Entrega programada por região"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "A horta mais próxima atende sua região. Menos deslocamento, mais frescor — operação consciente e planejada."
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Link de contato"
    }
  ],
  "blocks": [
    {
      "type": "cluster",
      "name": "Cluster regional",
      "settings": [
        { "type": "text", "id": "zone", "label": "Zona" },
        { "type": "text", "id": "horta", "label": "Nome da horta" },
        { "type": "text", "id": "day", "label": "Dia da entrega" },
        { "type": "text", "id": "radius", "label": "Raio de entrega" },
        { "type": "textarea", "id": "neighborhoods", "label": "Bairros atendidos", "info": "Separe por vírgula." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Entrega por Região",
      "blocks": [
        { "type": "cluster", "settings": { "zone": "Zona Norte", "horta": "Horta Zona Norte", "day": "Quarta-feira", "radius": "10 km", "neighborhoods": "Santana, Tucuruvi, Tremembé, Vila Maria, Casa Verde, Limão, Brasilândia" } },
