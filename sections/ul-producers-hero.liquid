{{ 'ul-tokens.css' | asset_url | stylesheet_tag }}
{{ 'ul-base.css' | asset_url | stylesheet_tag }}
{{ 'ul-animations.css' | asset_url | stylesheet_tag }}

<section class="ul-producers-hero">
  <div class="ul-container">
    <h1 class="ul-producers-hero__title ul-reveal">{{ section.settings.heading }}</h1>
    <p class="ul-producers-hero__subtitle ul-reveal ul-reveal-delay-1">{{ section.settings.subheading }}</p>
  </div>
</section>

{% stylesheet %}
  .ul-producers-hero {
    background: var(--ul-color-white);
    border-bottom: 1px solid var(--ul-color-border);
    padding-block: 4.5rem;
  }

  .ul-producers-hero__title {
    margin: 0 0 1rem;
    font-family: var(--ul-font-family);
    font-weight: var(--ul-font-weight-bold);
    font-size: 2rem;
    line-height: 1.15;
    color: var(--ul-color-foreground);
    text-align: center;
  }

  @media (min-width: 768px) {
    .ul-producers-hero__title {
      font-size: 2.75rem;
    }
  }

  .ul-producers-hero__subtitle {
    margin: 0 auto;
    max-width: 40rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ul-color-muted-foreground);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Produtores",
  "tag": "section",
  "class": "ul-producers-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Produtores Parceiros"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Conheça os produtores agroecológicos urbanos da Zona Norte de São Paulo que fazem parte da Urban Life."
    }
  ],
  "presets": [
    {
      "name": "Hero Produtores"
    }
  ]
}
{% endschema %}
