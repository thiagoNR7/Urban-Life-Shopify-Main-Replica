{%- doc -%}
  Card de produto para a grade "Produtos deste produtor" (Etapa 3 - Urban
  Life). Snippet dedicado, independente dos blocos nativos de produto do
  Horizon (_product-card, price), que dependem fortemente de contexto de
  bloco/secao (block.settings, block.id, template.name) para funcionar.

  @param {object} product - Objeto de produto do Shopify (collections.all.products).

  @example
  {% render 'ul-producer-product-card', product: product %}
{%- enddoc -%}

{%- liquid
  assign product_image = product.featured_image
-%}

<a href="{{ product.url }}" class="ul-producer-product-card">
  <span class="ul-producer-product-card__image">
    {%- if product_image != blank -%}
      {{
        product_image
        | image_url: width: 480
        | image_tag:
          alt: product.title,
          loading: 'lazy',
          sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw',
          widths: '320, 400, 480',
          class: 'ul-producer-product-card__img'
      }}
    {%- else -%}
      <span class="ul-producer-product-card__image-fallback">
        {% render 'ul-icon', name: 'sprout', size: 40 %}
      </span>
    {%- endif -%}

    {%- unless product.available -%}
      <span class="ul-producer-product-card__badge">Esgotado</span>
    {%- endunless -%}
  </span>

  <span class="ul-producer-product-card__body">
    <span class="ul-producer-product-card__title">{{ product.title }}</span>
    <span class="ul-producer-product-card__price">{{ product.price | money }}</span>
    <span class="ul-producer-product-card__cta">
      Ver produto
      {% render 'ul-icon', name: 'arrow-right', size: 14 %}
    </span>
  </span>
</a>

{% stylesheet %}
  .ul-producer-product-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--ul-color-white);
    border: 1px solid var(--ul-color-border);
    border-radius: var(--ul-radius-card);
    box-shadow: var(--ul-shadow-card-sm);
    overflow: hidden;
    text-decoration: none;
    transition: box-shadow 200ms ease, transform 200ms ease;
  }

  .ul-producer-product-card:hover,
  .ul-producer-product-card:focus-visible {
    box-shadow: var(--ul-shadow-card-md-hover);
    transform: translateY(-2px);
  }

  .ul-producer-product-card__image {
    position: relative;
    display: block;
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: var(--ul-color-secondary);
  }

  .ul-producer-product-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ul-producer-product-card__image-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--ul-color-olive-light);
    background: var(--ul-color-secondary);
  }

  .ul-producer-product-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 12px;
    border-radius: var(--ul-radius-pill);
    background: var(--ul-color-foreground);
    color: var(--ul-color-background);
    font-size: 0.6875rem;
    font-weight: var(--ul-font-weight-semibold);
    letter-spacing: 0.03em;
  }

  .ul-producer-product-card__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 1rem 1.125rem 1.25rem;
  }

  .ul-producer-product-card__title {
    font-size: 0.9375rem;
    font-weight: var(--ul-font-weight-semibold);
    color: var(--ul-color-foreground);
  }

  .ul-producer-product-card__price {
    font-size: 0.9375rem;
    font-weight: var(--ul-font-weight-bold);
    color: var(--ul-color-primary);
  }

  .ul-producer-product-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    color: var(--ul-color-primary);
    font-size: 0.8125rem;
    font-weight: var(--ul-font-weight-semibold);
  }

  @media (prefers-reduced-motion: reduce) {
    .ul-producer-product-card {
      transition: none;
    }
  }
{% endstylesheet %}
