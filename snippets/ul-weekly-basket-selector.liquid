    </div>
  </div>
</ul-weekly-basket-selector-component>

<script src="{{ 'ul-weekly-basket-selector.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .ul-weekly-basket {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ul-weekly-basket__tabs {
    display: flex;
    border: 1px solid var(--ul-color-border);
    border-radius: var(--ul-radius-base);
    background: var(--ul-color-background);
    overflow: hidden;
  }

  .ul-weekly-basket__tab {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-height: 56px;
    padding: 6px 8px;
    border: none;
    border-left: 1px solid var(--ul-color-border);
    background: transparent;
    color: var(--ul-color-foreground);
    font-family: var(--ul-font-family);
    text-align: center;
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease;
  }

  .ul-weekly-basket__tab:first-child {
    border-left: none;
  }

  .ul-weekly-basket__tab:hover {
    background: rgb(var(--ul-color-primary-rgb) / 0.06);
  }

  .ul-weekly-basket__tab-letter {
    font-size: 0.9375rem;
    font-weight: var(--ul-font-weight-bold);
    line-height: 1.2;
  }

  .ul-weekly-basket__tab-name {
    font-size: 0.75rem;
    font-weight: var(--ul-font-weight-semibold);
  }

  .ul-weekly-basket__tab-count {
    font-size: 0.6875rem;
    opacity: 0.75;
  }

  .ul-weekly-basket__tab[aria-selected='true'] {
    background: var(--ul-color-primary);
    color: var(--ul-color-primary-foreground);
  }

  .ul-weekly-basket__tab[aria-selected='true']:hover {
    background: var(--ul-color-primary);
  }

  .ul-weekly-basket__tab:focus-visible {
    outline: 2px solid var(--ul-color-primary);
    outline-offset: -2px;
  }

  .ul-weekly-basket__panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .ul-weekly-basket__panel-name {
    margin: 0;
    font-family: var(--ul-font-family);
    font-size: 0.9375rem;
    font-weight: var(--ul-font-weight-bold);
    color: var(--ul-color-foreground);
  }

  .ul-weekly-basket__panel-count {
    margin: 0;
    color: var(--ul-color-muted-foreground);
    font-size: 0.75rem;
  }

  .ul-weekly-basket__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
    row-gap: 8px;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 380px) {
    .ul-weekly-basket__items {
      grid-template-columns: 1fr;
    }
  }

  .ul-weekly-basket__items li {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    color: var(--ul-color-foreground);
    font-size: 0.8125rem;
    line-height: 1.4;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .ul-weekly-basket__item-icon {
    flex-shrink: 0;
    color: var(--ul-color-primary);
  }

  .ul-weekly-basket__items-empty {
    margin: 0.5rem 0 0;
    color: var(--ul-color-muted-foreground);
    font-size: 0.8125rem;
    font-style: italic;
  }

  .ul-weekly-basket__panel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 0.375rem;
  }

  .ul-weekly-basket__price-wrap {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .ul-weekly-basket__price {
    font-size: 1.375rem;
    font-weight: var(--ul-font-weight-bold);
    color: var(--ul-color-primary);
    letter-spacing: -0.01em;
  }

  .ul-weekly-basket__availability {
    font-size: 0.75rem;
    font-weight: var(--ul-font-weight-medium);
  }

  .ul-weekly-basket__availability--in-stock {
    color: var(--ul-color-olive-light);
  }

  .ul-weekly-basket__availability--out-of-stock {
    color: var(--ul-color-muted-foreground);
  }

  .ul-weekly-basket__pending {
    color: var(--ul-color-muted-foreground);
    font-size: 0.8125rem;
    font-style: italic;
  }

  .ul-weekly-basket__cta {
    flex: 1 1 auto;
    min-width: 180px;
  }

  .ul-weekly-basket__cta:disabled,
  .ul-weekly-basket__cta[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .ul-weekly-basket__cart-error {
    width: 100%;
    margin: 0;
    color: var(--ul-color-destructive);
    font-size: 0.8125rem;
  }

  .ul-weekly-basket__cart-error[hidden] {
    display: none;
  }

  .ul-weekly-basket__swap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ul-color-border);
  }

  .ul-weekly-basket__swap-heading {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--ul-color-foreground);
    font-family: var(--ul-font-family);
    font-size: 0.8125rem;
    font-weight: var(--ul-font-weight-bold);
  }

  .ul-weekly-basket__swap-icon {
    flex-shrink: 0;
    color: var(--ul-color-primary);
  }

  .ul-weekly-basket__swap-prompt {
    margin: 0;
    color: var(--ul-color-muted-foreground);
    font-size: 0.8125rem;
  }

  .ul-weekly-basket__swap-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ul-weekly-basket__swap-field {
    display: flex;
    flex: 1 1 140px;
    flex-direction: column;
    gap: 4px;
    font-family: var(--ul-font-family);
    font-size: 0.75rem;
    font-weight: var(--ul-font-weight-medium);
    color: var(--ul-color-muted-foreground);
  }

  .ul-weekly-basket__swap-select {
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--ul-color-border);
    border-radius: 0.75rem;
    background: var(--ul-color-background);
    color: var(--ul-color-foreground);
    font-family: var(--ul-font-family);
    font-size: 0.8125rem;
    transition: border-color 180ms ease;
  }

  .ul-weekly-basket__swap-select:focus-visible {
    outline: 2px solid var(--ul-color-primary);
    outline-offset: 1px;
  }

  .ul-weekly-basket__swap-select:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ul-weekly-basket__swap-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 12px;
    border-radius: 0.75rem;
    background: rgb(var(--ul-color-primary-rgb) / 0.08);
  }

  .ul-weekly-basket__swap-summary[hidden] {
    display: none;
  }

  .ul-weekly-basket__swap-summary-text {
    margin: 0;
    color: var(--ul-color-foreground);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .ul-weekly-basket__swap-remove {
    padding: 0;
    border: none;
    background: none;
    color: var(--ul-color-primary);
    font-family: var(--ul-font-family);
    font-size: 0.75rem;
    font-weight: var(--ul-font-weight-semibold);
    text-decoration: underline;
    cursor: pointer;
  }

  .ul-weekly-basket__swap-picker[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ul-weekly-basket__tab,
    .ul-weekly-basket__swap-select {
      transition: none;
    }
  }

  @media (min-width: 480px) {
    .ul-weekly-basket__cta {
      flex: 0 0 auto;
    }
  }
{% endstylesheet %}
