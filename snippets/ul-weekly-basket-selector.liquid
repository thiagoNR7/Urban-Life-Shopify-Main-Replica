            </p>
            <button type="button" class="ul-weekly-basket__swap-remove" on:click="/removeSwap">Remover troca</button>
          </div>

          <div class="ul-weekly-basket__swap-picker" data-swap-picker>
            <p class="ul-weekly-basket__swap-heading">
              {% render 'ul-icon', name: 'repeat', size: 14, class: 'ul-weekly-basket__swap-icon' %}
